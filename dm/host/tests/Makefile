	$(B)/t_peanuts_stopworld
	TMPDIR="$(abspath $(B))" $(B)/t_peanuts_padgate
	$(B)/t_peanuts_host "$(abspath $(B))"
	$(B)/t_peanuts_frametime
	$(B)/t_peanuts_graph
	TMPDIR="$(abspath $(B))" $(B)/t_peanuts_audiosync
ifeq ($(shell uname -s),Linux)
run: peanuts-host
endif
